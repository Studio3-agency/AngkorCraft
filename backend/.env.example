# --- AngkorCraft backend environment ---
# Copy this file to `.env` and fill in the values. NEVER commit `.env`.
# Everything here is SECRET and must stay server-side only.

# Port the API listens on (Render sets PORT automatically in production).
PORT=4000

# Comma-separated list of allowed frontend origins for CORS.
# An entry may use `*` as a wildcard for one hostname label, so a single
# `https://*.vercel.app` entry covers your production site AND every Vercel
# preview deploy (each gets its own generated subdomain).
# Local dev default below; in production use e.g.:
#   CORS_ORIGINS=https://your-app.vercel.app,https://*.vercel.app
CORS_ORIGINS=http://localhost:3000

# --- Supabase (Project Settings -> API) ---
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
# service_role key — FULL ADMIN ACCESS. Backend only, never in the frontend.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# --- Cloudinary (Dashboard -> API keys) ---
CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET
