# --- AngkorCraft frontend environment ---
# Copy this file to `.env.local` and fill in the values.
# Only VITE_-prefixed vars are exposed to the browser. NEVER put secrets here.

# Supabase project URL (Supabase dashboard -> Project Settings -> API -> Project URL)
VITE_SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"

# Supabase anon/public key (Project Settings -> API -> Project API keys -> anon public)
# Safe to expose in the browser; access is still enforced by Row-Level Security.
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Base URL of the AngkorCraft backend API (Cloudinary signing + cascade delete).
# Local dev default:
VITE_API_BASE_URL="http://localhost:4000"

# Cloudinary cloud name (Cloudinary dashboard -> Product Environment / cloud name).
# Public identifier only, safe to expose. The API key/secret live in the backend.
VITE_CLOUDINARY_CLOUD_NAME="YOUR_CLOUDINARY_CLOUD_NAME"
